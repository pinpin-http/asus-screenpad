# Maintainer: pinpin-http <https://github.com/pinpin-http>
pkgname=omarchy-screenpad
pkgver=0.1.1
pkgrel=1
pkgdesc='ASUS ScreenPad Plus brightness controls for the Omarchy bar'
arch=('any')
url='https://github.com/pinpin-http/omarchy-screenpad'
license=('MIT')
depends=('omarchy>=4.0' 'quickshell' 'python' 'brightnessctl')
source=("$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('8b1894c83df3ecbc5471ea766b1b8c0ad56dced04d7936c6f6af97127fc0e92d')

check() {
  cd "$srcdir/$pkgname-$pkgver"
  python -m unittest discover -s tests -v
  omarchy plugin validate .
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  local data_dir="$pkgdir/usr/share/$pkgname"
  install -d "$data_dir"
  install -m644 manifest.json Panel.qml README.md LICENSE "$data_dir/"
  install -m755 screenpadctl install.sh "$data_dir/"
  install -Dm755 screenpadctl "$pkgdir/usr/bin/screenpadctl"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm755 packaging/omarchy-screenpad-install "$pkgdir/usr/bin/omarchy-screenpad-install"
}
